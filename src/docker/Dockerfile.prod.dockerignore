# Build context rules for Dockerfile.prod only.
# BuildKit uses this file instead of the root .dockerignore when it builds
# Dockerfile.prod, so everything the root file lists is repeated here.
# The production image is published to a registry: nothing secret or
# specific to one installation may be copied into it.

# Environment files (supplied at runtime through env_file)
.env*

# TLS certificates and private keys (mounted at runtime)
src/certs/**
!src/certs/**/.gitkeep

# Generated config and logs (mounted at runtime, config is recreated on start)
src/config
src/logs

# Local databases
**/*.sqlite
**/*.sqlite-wal
**/*.sqlite-shm

# Dependencies
node_modules
npm-debug.log
yarn-error.log
bun.lockb

# Git
.git
.gitignore
.gitattributes

# IDE
.vscode
.idea
.claude
.VSCodeCounter
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage
*.test.ts
*.spec.ts

# Documentation
*.md
docs

# CI/CD
.github
.gitlab-ci.yml

# Development tools
.husky
.eslintrc*
.prettierrc*

# Build artifacts
dist
build
*.log

# Docker
Dockerfile
docker-compose*.yml
.dockerignore
