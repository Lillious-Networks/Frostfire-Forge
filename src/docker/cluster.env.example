# Template for src/docker/cluster.env, the shared settings of the Frostfire
# cluster test stack (src/docker/docker-compose.cluster.yml).
#
# Copy this file to src/docker/cluster.env (which is git-ignored) and GENERATE
# EACH SECRET PER STACK: every `change-me` below needs its own fresh random
# value, never reused between keys, stacks or environments, and never copied
# from or into a production .env. For example:
#   bun -e "console.log(crypto.randomBytes(32).toString('hex'))"
#
# Pass the file to every compose command with --env-file as well as relying on
# it as `env_file` (the compose file's header shows the commands). The stack is
# a local, disposable one; do not point it at a real database.
#
# Loaded as `env_file` by every service. Per-service ports and node identity are
# set in the compose file's `environment:` blocks, which override this file.

# --- Database (one MySQL shared by the engine nodes and the gateway) ---
# The mysql image reads MYSQL_ROOT_PASSWORD / MYSQL_DATABASE; the apps read DATABASE_*.
# The test MySQL volume keeps the password it was first created with: change it
# only on a fresh volume (`down -v`).
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=frostfire_cluster_test
DATABASE_ENGINE=mysql
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=frostfire_cluster_test
DATABASE_USER=root
DATABASE_PASSWORD=change-me
SQL_SSL_MODE=DISABLED

# --- Keys shared between services (same value on both sides) ---
# gateway <-> engine
GATEWAY_AUTH_KEY=change-me
# gateway signs, engine verifies
GATEWAY_GAME_SERVER_SECRET=change-me
# engine <-> asset server
ASSET_SERVER_AUTH_KEY=change-me

# --- Cluster secrets ---
# Redis password: the redis service requires it and the nodes and coordinator
# put it in their REDIS_URL (built in docker-compose.cluster.yml). Redis holds
# the cluster's records; they are sealed, but a seal does not stop a delete or
# a replay, so the password must be long and random: the nodes refuse to start
# with "change-me" or with no password in REDIS_URL. A rediss:// URL with no
# password is accepted, but TLS alone does not authenticate the client: give it
# a password (or an ACL user) too.
# Generate one with: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
REDIS_PASSWORD=change-me
# Signs and verifies the node-to-node link and bus traffic. Only the nodes and the
# coordinator should hold it. It must be at least 32 characters: the nodes refuse to
# start with a shorter one, so this placeholder fails until it is replaced.
# Generate one with: bun -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
CLUSTER_LINK_SECRET=change-me

# --- Common settings ---
GAME_NAME=Frostfire Cluster Test
LOG_LEVEL=info
# Plain HTTP everywhere: the browser talks to localhost, and the game servers pin
# their own self-generated WebTransport certificate through /wt-cert-hash.
HTTP_USE_SSL=false
