# Database Configuration
DATABASE_ENGINE=mysql
DATABASE_HOST=localhost
DATABASE_NAME=frostfire_forge
DATABASE_USER=root
DATABASE_PASSWORD=your_secure_password
DATABASE_PORT=3306
SQL_SSL_MODE=DISABLED

# Translation Services
GOOGLE_TRANSLATE_API_KEY=
OPENAI_API_KEY=
TRANSLATION_SERVICE=
OPENAI_MODEL=

# Security (Optional)
SESSION_KEY=
RSA_PASSPHRASE=

# Application Configuration
WEBSRV_PORT=3000
WEBSRV_PORTSSL=3000
WEBSRV_INTERNAL_PORT=3002
HTTP_USE_SSL=false

# HTTP protocol toggles (HTTP API behind the edge proxy)
# WEBSRV_HTTP1=false disables HTTP/1.1 (default: on)
# WEBSRV_HTTP2=false disables HTTP/2 (default: on)
# WEBSRV_HTTP3=false disables HTTP/3 (default: on, TLS only)
# NOTE: HTTP/3 is force-disabled for the game server - the WebTransport (QUIC)
# listener owns the UDP port shared with the HTTP API's port number.
WEBSRV_HTTP1=true
WEBSRV_HTTP2=true
WEBSRV_HTTP3=false

TLS_CERT_PATH=./src/certs/cert.pem
TLS_KEY_PATH=./src/certs/key.pem
TLS_CA_PATH=./src/certs/cert.ca-bundle
GAME_NAME=Frostfire Forge
LOG_LEVEL=info

# Local certificate handling (Optional)
# Set to "true" to skip auto-trusting generated certificates on Windows
SKIP_CERT_TRUST=false

# TLS verification (Optional)
# Defaults to "true": the startup probe and local benchmark runs skip
# verification against self-signed certificates. Set to "false" to require
# full verification against the configured certificate.
TLS_INSECURE_SKIP_VERIFY=true

# CORS Configuration (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Gateway (Required)
GATEWAY_URL=http://localhost:9999
# Optional: internal (server-to-server) gateway endpoint. Use the gateway's
# internal HTTPS port (127.0.0.1:GATEWAY_INTERNAL_PORT) when the public
# listener has HTTP/1.1 disabled.
GATEWAY_INTERNAL_URL=
GATEWAY_AUTH_KEY=your_secure_gateway_auth_key
GATEWAY_GAME_SERVER_SECRET=your_secure_shared_secret

# Realm Configuration
SERVER_ID=server-1
SERVER_DESCRIPTION=My Realm
SERVER_HOST=localhost
PUBLIC_HOST=localhost
WHITELIST=false
# "false" stops harmful spells between players (beneficial spells still work)
PVP=true

# Asset Server (Required)
ASSET_SERVER_URL=http://localhost:8000
# Optional: internal (server-to-server) asset endpoint (see GATEWAY_INTERNAL_URL).
ASSET_SERVER_INTERNAL_URL=
ASSET_SERVER_AUTH_KEY=your_secure_asset_server_auth_key

# Real weather (Optional): a world set to "weather_api" follows a real place, read from
# OpenWeatherMap's free Current Weather Data API (https://openweathermap.org/api).
# Leave the key or the location empty to turn it off.
WEATHER_API_KEY=
# "lat,lon" (47.61,-122.33) or a city and its country (Seattle,US)
WEATHER_API_LOCATION=
# Minutes between readings (default: 10)
WEATHER_API_MINUTES=10

# Cache Configuration
CACHE=memory
REDIS_URL=

# Cluster mode (Optional): one world shared by several engine processes ("nodes").
# Leave CLUSTER unset (or "false") for a single server; nothing below is read then.
# A cluster node needs CACHE=redis and REDIS_URL above.
#CLUSTER=true
# This node's name, and the region the whole cluster serves: 1-64 letters, digits, '_' or '-'.
#NODE_ID=node-1
#REGION_ID=EU
# Signs the node links and the cluster bus. Required with CLUSTER=true: at least 32
# random characters, the same on every node and the coordinator, and on nothing else
# (not the webserver, not the Gateway). Never reuse GATEWAY_GAME_SERVER_SECRET.
# Generate one with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#CLUSTER_LINK_SECRET=
# Node links: a UDP (QUIC) listener per node, on the game port + 1 unless set.
#NODE_LINK_PORT=
# The address the other nodes dial for this node's links (default: SERVER_HOST).
#NODE_LINK_HOST=
# The interface the link listener binds (default 0.0.0.0, every interface; the node
# logs a warning at startup then). Set it to this node's private-network address.
# Either way, firewall the link UDP port so that only the other nodes' addresses can
# reach it, and never publish or map it to the internet: the listener's own limits do
# not hold against a flood from outside.
#NODE_LINK_BIND_HOST=
# Every node and the coordinator must keep its clock synced (NTP): link hellos and bus
# messages more than 10 s off the receiver's clock are dropped.
# Docker cluster on this machine (bun docker:prod:cluster:rebuild): how many engine nodes
# (1-16) and coordinators (1-4, default 1) it runs. Each container gets its own NODE_ID,
# SERVER_ID and ports (the base ports above + 10 per node), so leave those unset here.
#CLUSTER_NODES=3
#CLUSTER_COORDINATORS=1

# Worker Pools (Optional - defaults to 8)
DB_WORKER_POOL_SIZE=8
AUTH_POOL_SIZE=8

# Benchmarking (Optional)
# Set to "true" to disable WebTransport handshake rate limits.
WT_HANDSHAKE_RATE_LIMIT_DISABLED=false
